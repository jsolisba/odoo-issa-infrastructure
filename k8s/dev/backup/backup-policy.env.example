# Odoo K3s DEV - Backup Policy
ENVIRONMENT=dev
K8S_NAMESPACE=dev

# Schedule: daily at 02:00 America/Costa_Rica
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_TIMEZONE=America/Costa_Rica

# Local storage
BACKUP_ROOT=/mnt/longhorn-backups/backups/odoo/dev
LOCAL_RETENTION_DAYS=7

# Remote storage
B2_PREFIX=k3s/dev
REMOTE_RETENTION_DAYS=30

# Monthly restore verification
RESTORE_TEST_SCHEDULE="0 3 1 * *"

# Safety
VERIFY_CHECKSUMS=true
VERIFY_REMOTE=true
DELETE_EXISTING_DATA=false
